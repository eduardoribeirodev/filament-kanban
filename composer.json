{
    "name": "eduardoribeirodev/filament-kanban",
    "description": "Kanban boards for Filament with native filters, actions, infolists, drag and drop, and progressive loading.",
    "keywords": [
        "filament",
        "kanban",
        "laravel",
        "livewire",
        "drag-and-drop",
        "infinite-scroll"
    ],
    "homepage": "https://github.com/eduardoribeirodev/filament-kanban",
    "license": "MIT",
    "authors": [
        {
            "name": "Eduardo Ribeiro",
            "email": "eduribeiro.films@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "filament/filament": "^5.0",
        "livewire/livewire": "^4.1"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "EduardoRibeiroDev\\FilamentKanban\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EduardoRibeiroDev\\FilamentKanban\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "EduardoRibeiroDev\\FilamentKanban\\FilamentKanbanServiceProvider"
            ]
        }
    },
    "type": "library",
    "support": {
        "issues": "https://github.com/eduardoribeirodev/filament-kanban/issues",
        "source": "https://github.com/eduardoribeirodev/filament-kanban"
    }
}
